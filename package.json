{
  "name": "conversational-experience-router",
  "version": "0.1.0",
  "private": true,
  "description": "A safety-first experience layer for conversational AI, with a Claude MCP reference adapter.",
  "type": "module",
  "bin": {
    "conversational-experience-router": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/runtime.test.mjs",
    "validate-module": "npm run build --silent && node scripts/validate-module.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
